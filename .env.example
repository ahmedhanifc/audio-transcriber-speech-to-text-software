OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional. Part of the mic's name, e.g. alsa_input (always the laptop mic), bluez (AirPods) or pulse (whatever the system default is)
MIC=
# Optional. gpt-4o-transcribe (default), gpt-transcribe, or gemini-3.5-transcribe
STT_MODEL=
# Optional. Comma-separated words the model often gets wrong
KEYWORDS=
# Optional. Folder for a daily copy of meetings.db, e.g. ~/Backups/audio-transcriber
BACKUP_DIR=
# Ask tab. claude (default) or codex. Old chats only continue with the one that started them.
ASK_AGENT=
# Optional. Empty uses your own CLI settings. Model: opus, sonnet, haiku or a full name. Effort: low, medium, high, xhigh, max
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Optional. Empty uses ~/.codex/config.toml. Model: e.g. gpt-6-astra. Effort: none, minimal, low, medium, high, xhigh, max
CODEX_MODEL=
CODEX_EFFORT=
