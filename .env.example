OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional. Part of the mic's name, e.g. alsa_input (always the laptop mic), bluez (AirPods) or pulse (whatever the system default is)
MIC=
# Optional. gpt-4o-transcribe (default), gpt-transcribe, or gemini-3.5-transcribe
STT_MODEL=
# Optional. Comma-separated words the model often gets wrong
KEYWORDS=
# Optional. Folder for a daily copy of meetings.db, e.g. ~/Backups/audio-transcriber
BACKUP_DIR=
